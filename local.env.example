# Copy to local.env and customise. Never commit local.env.
# Environment overrides win. Paths below are placeholders, not installed models.
# Qwen is only the example configuration; any GGUF model your llama-server
# build supports can be used.

# --- How llama-server is run -----------------------------------------------
# managed (default): the launcher starts llama-server with QWEN_MODEL and can
#   switch models from the browser.
# external: you start llama-server yourself; the app only connects to
#   LLAMA_SERVER_URL, reads the loaded model from the server, and never
#   starts, stops or restarts it.
# : "${LLAMA_SERVER_MODE:=external}"
# : "${LLAMA_SERVER_URL:=http://127.0.0.1:8081}"

# --- Managed mode ------------------------------------------------------------
: "${QWEN_MODEL:=/path/to/your-model.gguf}"
: "${LLAMA_SERVER_BIN:=llama-server}"
# Directories searched for GGUF files to offer in the model selector
# (colon-separated). Placeholders; use your own folders.
# : "${LLAMA_MODEL_DIRS:=/path/to/models:/path/to/more-models}"
# Extra llama-server flags for every managed start.
# : "${LLAMA_SERVER_EXTRA_ARGS:=}"
# Seconds to wait for a model to load before reporting failure.
# : "${QWEN_STARTUP_TIMEOUT:=600}"

# --- Ports and capacity ------------------------------------------------------
# : "${QWEN_APP_PORT:=8090}"
# : "${LLAMA_SERVER_PORT:=8081}"
# : "${LLAMA_SERVER_CTX:=32768}"

# --- Review defaults (effect depends on the model; see README) --------------
# : "${LLAMA_REASONING_EFFORT:=medium}"
# : "${QWEN_VISION_TABLES:=1}"
# Set to 0 to stop managed launchers loading a *mmproj*.gguf beside the model.
# : "${QWEN_LOAD_MMPROJ:=1}"

# --- Saved reviews -------------------------------------------------------------
# Folder for saved reviews (they contain manuscript text: keep it private).
# Unset: reviews/sessions in this folder. "off": nothing is saved. Paths with
# spaces are fine. A configured folder is used exactly as given; if it is
# missing (for example, its drive is not connected) the app says so and does
# not fall back to the default.
# : "${QWEN_REVIEW_STORE:=/path/to/My Reviews/sessions}"

# --- Academic Chat reference checks ------------------------------------------
# Optional contact (URL or mailto:) sent in the User-Agent to Crossref and
# OpenAlex. Unset: none is sent.
# : "${QWEN_CONTACT_URL:=mailto:you@example.org}"
